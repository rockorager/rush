.{
    .name = "2.7 Redirection",
    .mode = .posix,
    .cases = .{
        .{
            .name = "ampersand before output redirection remains a command separator in POSIX mode",
            .script =
            \\false && printf 'bad\n' &>out
            \\printf 'survived\n'
            ,
            .stdout = "survived\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "ampersand before append redirection remains a command separator in POSIX mode",
            .script =
            \\false && printf 'bad\n' &>>out
            \\printf 'survived\n'
            ,
            .stdout = "survived\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "case suffix in command substitution is ordinary argument text",
            .script =
            \\eval 'test $(printf -- --ignore-case MYTAG) = --ignore-case'
            \\echo status=$?
            ,
            .stdout = "status=0\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "literal case argument does not start a case command in command substitution",
            .script =
            \\printf '<%s>\n' "$(printf '%s' case)"
            \\printf '<%s>\n' "$(printf '%s ' then case)"
            \\printf '<%s>\n' "$(if true; then case x in x) printf yes;; esac; fi)"
            \\printf '<%s>\n' "$(for x in x; do case x in x) printf loop;; esac; done)"
            \\printf '<%s>\n' "$({ case x in x) printf group;; esac; })"
            ,
            .stdout = "<case>\n<then case >\n<yes>\n<loop>\n<group>\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "output redirection creates and truncates the target file",
            .script =
            \\printf '%s\n' old >out
            \\printf '%s\n' new >out
            \\cat out
            ,
            .stdout =
            \\new
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "append redirection appends to the target file",
            .script =
            \\printf '%s\n' first >out
            \\printf '%s\n' second >>out
            \\cat out
            ,
            .stdout =
            \\first
            \\second
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input redirection supplies standard input",
            .script =
            \\printf '%s\n' input >in
            \\cat <in
            ,
            .stdout =
            \\input
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input-output redirection opens a file for reading and writing",
            .script =
            \\printf '%s\n' old >rw
            \\printf '%s\n' new 1<>rw
            \\cat rw
            ,
            .stdout =
            \\new
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input-output redirection supplies standard input",
            .script =
            \\printf 'abc' >rw
            \\cat <>rw
            \\printf '\n'
            ,
            .stdout =
            \\abc
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input-output redirection creates a missing file",
            .script =
            \\: <>rw
            \\test -f rw && printf 'created\n'
            ,
            .stdout =
            \\created
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirection without a command is performed in the current environment",
            .script =
            \\: >created
            \\test -f created && printf 'created\n'
            ,
            .stdout =
            \\created
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "explicit io number redirects standard error",
            .script =
            \\{ printf 'out\n'; printf 'err\n' >&2; } 2>err
            \\printf 'after\n'
            \\cat err
            ,
            .stdout =
            \\out
            \\after
            \\err
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "io number removes backslash-newline before redirection operator",
            .script =
            \\echo ok 1\
            \\>out
            \\cat out
            ,
            .stdout =
            \\ok
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command substitution preserves descriptor swap routing",
            .script =
            \\v=$(exec 3>&1 1>&2 2>&3; printf out; printf err >&2)
            \\printf '<%s>\n' "$v"
            ,
            .stdout =
            \\<err>
            \\
            ,
            .stderr = "out",
            .status = 0,
        },
        .{
            .name = "exec redirection in brace group persists in current shell",
            .script =
            \\{ exec 4>&1; }
            \\printf 'after\n' >&4
            ,
            .stdout =
            \\after
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "subshell flushes stdout before later duplicate-output redirection",
            .script =
            \\{ exec 4>&1; }
            \\( printf '[%s]\n' two; printf '%s\n' three >&4; )
            ,
            .stdout =
            \\[two]
            \\three
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "nested subshell flushes stdout before child output after exec redirection",
            .script =
            \\unset A
            \\exec 3>&1
            \\( printf '%s\n' until; exec 3>&2; ( printf '%s\n' "${A-default}"; : > a; ); )
            ,
            .stdout =
            \\until
            \\default
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "exec redirection before failed brace group command persists",
            .script =
            \\{ exec 3>>out; false <missing; }
            \\printf 'after\n' >&3
            \\cat out
            ,
            .stdout =
            \\after
            \\
            ,
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "exec redirection before failed brace group command is inherited by subshell",
            .script =
            \\{ exec 3>>out; false <missing; }
            \\( printf 'after\n' >&3 )
            \\cat out
            ,
            .stdout =
            \\after
            \\
            ,
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "subshell printf inherits exec redirection to nonstandard descriptor",
            .script =
            \\( exec 3>>out; printf '%s\n' '' >&3 )
            \\printf 'after\n'
            \\set -- $(wc -c <out)
            \\printf 'bytes:%s\n' "$1"
            ,
            .stdout =
            \\after
            \\bytes:1
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "subshell exec redirection reopens a previously closed descriptor",
            .script =
            \\( exec 3>&-; exec 3>&1; printf '%s\n' saved >&3 )
            ,
            .stdout =
            \\saved
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "subshell scoped exec preserves inherited descriptor route",
            .script =
            \\exec 3>&2
            \\( exec 4>&1; printf '%s\n' two; printf '%s\n' three >&3 ) >out
            \\cat out
            ,
            .stdout =
            \\two
            \\
            ,
            .stderr =
            \\three
            \\
            ,
            .status = 0,
        },
        .{
            .name = "subshell saved stdout flushes before later external output",
            .script =
            \\( printf '%s\n' two; exec 3>&1; printf '%s\n' file >out; printf '%s\n' saved >&3; exec 3>&-; cat out )
            ,
            .stdout =
            \\two
            \\saved
            \\file
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "exec redirection in redirected brace group survives later redirection failure",
            .script =
            \\{ exec 3>>out; false <missing; } >>group
            \\( printf 'after\n' >&3 )
            \\cat out
            ,
            .stdout =
            \\after
            \\
            ,
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "nested command substitution side output preserves descriptor swap routing",
            .script =
            \\v=$(exec 3>&1 1>&2 2>&3; printf "$(printf inner >&2)"; printf outer >&2)
            \\printf '<%s>\n' "$v"
            ,
            .stdout =
            \\<innerouter>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "pipeline stage side output preserves descriptor swap routing",
            .script =
            \\v=$(exec 3>&1 1>&2 2>&3; printf out >&2 | cat; printf err >&2)
            \\printf '<%s>\n' "$v"
            ,
            .stdout =
            \\<outerr>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "quoted io number is not recognized as a redirection prefix",
            .script =
            \\\2>out
            \\test -e out && printf 'created\n'
            ,
            .stdout =
            \\created
            \\
            ,
            .stderr = "",
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "quoted redirection operator is passed as an argument",
            .script =
            \\printf '%s\n' 2\>out
            \\test ! -e out && printf 'no-file\n'
            ,
            .stdout =
            \\2>out
            \\no-file
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirections are evaluated left to right when stdout is redirected before stderr duplication",
            .script =
            \\{ printf '%s\n' out; printf '%s\n' err >&2; } >both 2>&1
            \\cat both
            ,
            .stdout =
            \\out
            \\err
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirections are evaluated left to right when stderr is duplicated before stdout redirect",
            .script =
            \\{ printf '%s\n' out; printf '%s\n' err >&2; } 2>&1 >out
            \\cat out
            ,
            .stdout =
            \\err
            \\out
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirection operand command substitution stderr precedes later redirections",
            .script =
            \\exec 2>&1
            \\: >$(printf out; printf 'err\n' >&2) 2>later
            \\printf 'later=<%s>\n' "$(cat later)"
            ,
            .stdout =
            \\err
            \\later=<>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command word expansion precedes command redirections",
            .script =
            \\printf 'arg=<%s>\n' "$(printf 'side\n' >&2; printf value)" 2>later
            \\printf 'later=<%s>\n' "$(cat later)"
            ,
            .stdout =
            \\arg=<value>
            \\later=<>
            \\
            ,
            .stderr =
            \\side
            \\
            ,
            .status = 0,
        },
        .{
            .name = "exec redirection order preserves duplicated stderr route before stdout redirect",
            .script =
            \\( exec 2>&1 >out; printf 'err\n' >&2 )
            \\printf 'out=<%s>\n' "$(cat out)"
            ,
            .stdout =
            \\err
            \\out=<>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command substitution captures stderr duplicated to stdout before stdout redirect",
            .script =
            \\exec 3>&1
            \\out=$( { printf out; printf err >&2; } 2>&1 1>&3 )
            \\printf ' captured=<%s>\n' "$out"
            ,
            .stdout =
            \\out captured=<err>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command substitution external here document preserves ordered output routing",
            .script =
            \\exec 3>&1
            \\out=$(sh -c 'cat; printf err >&2' 2>&1 1>&3 <<EOF
            \\out
            \\EOF
            \\)
            \\printf ' captured=<%s>\n' "$out"
            ,
            .stdout =
            \\out
            \\ captured=<err>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command substitution external pipeline input preserves ordered output routing",
            .script =
            \\exec 3>&1
            \\out=$(printf 'out\n' | sh -c 'cat; printf err >&2' 2>&1 1>&3)
            \\printf ' captured=<%s>\n' "$out"
            ,
            .stdout =
            \\out
            \\ captured=<err>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "command substitution external command reads redirected stdin",
            .script =
            \\printf file >in
            \\out=$(cat <in)
            \\printf '<%s>\n' "$out"
            ,
            .stdout =
            \\<file>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "duplicate redirection from a closed source descriptor fails before command execution",
            .script =
            \\exec 3>&2 2>&-
            \\printf bad >&2
            \\status=$?
            \\exec 2>&3 3>&-
            \\if [ "$status" -ne 0 ]; then printf '<nonzero>\n'; fi
            ,
            .stdout =
            \\<nonzero>
            \\
            ,
            .stderr_match = .any,
            .status = 0,
        },
        .{
            .name = "compound duplicate redirection fails when an earlier redirection closed the source",
            .script =
            \\{ printf out; printf err >&2; } 1>&- 2>&1
            \\status=$?
            \\if [ "$status" -ne 0 ]; then printf '<nonzero>\n'; fi
            ,
            .stdout =
            \\<nonzero>
            \\
            ,
            .stderr_match = .any,
            .status = 0,
        },
        .{
            .name = "self-duplicate redirection from a closed descriptor is a no-op",
            .script =
            \\exec 3>&1 1>&-
            \\printf '' 1>&1
            \\status=$?
            \\exec 1>&3 3>&-
            \\if [ "$status" -eq 0 ]; then printf '<zero>\n'; fi
            ,
            .stdout =
            \\<zero>
            \\
            ,
            .stderr_match = .any,
            .status = 0,
        },
        .{
            .name = "redirection word expansion does not perform field splitting",
            .script =
            \\name='a b'
            \\printf data >$name
            \\cat 'a b'
            ,
            .stdout = "data",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirection word expansion does not perform pathname expansion",
            .script =
            \\touch literal other
            \\name='*'
            \\printf data >$name
            \\cat '*'
            ,
            .stdout = "data",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "redirection word expansion performs command substitution",
            .script =
            \\printf data >$(printf out)
            \\cat out
            ,
            .stdout = "data",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "quoted empty redirection operand is a single pathname",
            .script =
            \\name=
            \\if : >"$name"; then printf 'created\n'; else printf 'failed\n'; fi
            ,
            .stdout = "",
            .stderr = "",
            .stderr_match = .nonempty,
            .status = 0,
            .status_match = .nonzero,
        },
        .{
            .name = "input redirection failure makes the command fail",
            .script = "cat <missing",
            .stdout = "",
            .stderr = "",
            .stderr_match = .nonempty,
            .status = 0,
            .status_match = .nonzero,
        },
        .{
            .name = "noclobber prevents output redirection from replacing an existing file",
            .script =
            \\set -C
            \\printf old >out
            \\if printf new >out; then printf 'replaced\n'; else printf 'failed\n'; fi
            \\cat out
            ,
            .stdout =
            \\failed
            \\old
            ,
            .stderr = "",
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "noclobber allows output redirection to existing non-regular files",
            .script =
            \\set -C
            \\printf ok >/dev/null
            \\printf '<%s>\n' "$?"
            ,
            .stdout =
            \\<0>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "clobber redirection overrides noclobber",
            .script =
            \\set -C
            \\printf old >out
            \\printf new >|out
            \\printf 'status:%s\n' "$?"
            \\cat out
            ,
            .stdout =
            \\status:0
            \\new
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input duplication reads from the duplicated descriptor",
            .script =
            \\printf 'abc' >in
            \\cat 3<in <&3
            \\printf '\n'
            ,
            .stdout =
            \\abc
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "output duplication writes to the duplicated descriptor",
            .script =
            \\printf 'via3\n' 3>&1 >&3
            ,
            .stdout =
            \\via3
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "closing an unopened output descriptor succeeds",
            .script =
            \\: 9>&-
            \\printf 'status:%s\n' "$?"
            ,
            .stdout =
            \\status:0
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "external pipeline stage with closed stdout reports command failure",
            .script =
            \\printf x | cat >&-
            \\printf 'status:%s\n' "$?"
            ,
            .stdout =
            \\status:1
            \\
            ,
            .stderr_match = .nonempty,
            .status = 0,
        },
        .{
            .name = "external pipeline stage can redirect stdout to a file",
            .script =
            \\printf x | cat >out
            \\cat out
            \\printf 'status:%s\n' "$?"
            ,
            .stdout =
            \\xstatus:0
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "external pipeline stage expands arguments and redirections once in order",
            .script =
            \\n=0
            \\printf unused | value=assigned sh -c 'printf "%s:%s\n" "$1" "$value"' sh "$((n+=1))" >"out$((n+=1))"
            \\cat out2
            \\printf 'parent:%s\n' "$n"
            ,
            .stdout =
            \\1:assigned
            \\parent:0
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "pipeline compound and function bodies retain commands after redirected external",
            .script =
            \\f() { cat >function-out; printf 'function-after\n'; }
            \\printf function-data | f
            \\printf compound-data | { cat >compound-out; printf 'compound-after\n'; }
            \\cat function-out compound-out
            ,
            .stdout =
            \\function-after
            \\compound-after
            \\function-datacompound-data
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "external pipeline stage can redirect stderr in a longer pipeline",
            .script =
            \\printf x | cat 2>/dev/null | wc -c | sed 's/^ *//'
            ,
            .stdout =
            \\1
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "input duplication can close standard input",
            .script = "cat <&-",
            .stdout = "",
            .stderr = "",
            .stderr_match = .nonempty,
            .status = 0,
            .status_match = .nonzero,
        },
        .{
            .name = "output redirection remains open across exec after standard output is closed",
            .script =
            \\exec 1>&-
            \\/bin/echo hi >out
            \\cat out >&2
            ,
            .stdout = "",
            .stderr =
            \\hi
            \\
            ,
            .status = 0,
        },
        .{
            .name = "stderr redirection remains open across exec after standard error is closed",
            .script =
            \\exec 2>&-
            \\/bin/sh -c 'echo err >&2' 2>err
            \\cat err
            ,
            .stdout =
            \\err
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "high fd redirection remains open across exec after descriptor is closed",
            .script =
            \\exec 3>&-
            \\/bin/sh -c 'echo hi >&3' 3>out
            \\cat out
            ,
            .stdout =
            \\hi
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document supplies input after standard input is closed",
            .script =
            \\exec 0<&-
            \\cat <<EOF
            \\hi
            \\EOF
            \\printf '<%s>\n' "$?"
            ,
            .stdout =
            \\hi
            \\<0>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document writer tolerates early reader exit",
            .script =
            \\cat <<EOF | head -c 1
            \\abcdef
            \\EOF
            \\printf '\nstatus:%s\n' "$?"
            ,
            .stdout =
            \\a
            \\status:0
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "large here document streams without pipe buffer deadlock",
            .script =
            \\count=$(cat <<EOF | wc -c
            \\$(awk 'BEGIN { for (i = 0; i < 131072; i++) printf "x" }')
            \\EOF
            \\)
            \\set -- $count
            \\printf '%s\n' "$1"
            ,
            .stdout =
            \\131073
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document redirection overrides earlier stdin close in the same command",
            .script =
            \\cat 0<&- <<EOF
            \\hi
            \\EOF
            \\printf '<%s>\n' "$?"
            ,
            .stdout =
            \\hi
            \\<0>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "ordered input redirections choose between file and here document",
            .script =
            \\printf file >in
            \\cat <<EOF <in
            \\hi
            \\EOF
            \\printf '\n'
            \\cat <in <<EOF
            \\hi
            \\EOF
            ,
            .stdout =
            \\file
            \\hi
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document can be combined with output redirection",
            .script =
            \\cat >out <<EOF
            \\hi
            \\EOF
            \\cat out
            ,
            .stdout =
            \\hi
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document body expands when delimiter is unquoted",
            .script =
            \\x=value
            \\cat <<EOF
            \\<$x>
            \\<$(printf command)>
            \\EOF
            ,
            .stdout =
            \\<value>
            \\<command>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document command substitution stderr precedes body output",
            .script =
            \\exec 2>&1
            \\cat <<EOF
            \\$(printf hi; printf err >&2)
            \\EOF
            ,
            .stdout =
            \\errhi
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document expands backquote command substitutions",
            .script =
            \\v=$(cat <<EOF
            \\one
            \\
            \\`printf 'two\n\n'`
            \\three
            \\
            \\` : `
            \\x
            \\EOF
            \\)
            \\printf '<%s>\n' "$v"
            ,
            .stdout =
            \\<one
            \\
            \\two
            \\three
            \\
            \\
            \\x>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document parameter operators remove quote syntax from words",
            .script =
            \\unset U
            \\S=set
            \\cat <<EOF
            \\${U-"1"}${U:-"2"}${S+"3"}${S:+"4"}
            \\EOF
            ,
            .stdout =
            \\1234
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document pattern removals honor quoted pattern literals",
            .script =
            \\v=ababcdcd
            \\cat <<EOF
            \\${v#*ab},${v##*ab},${v%cd*},${v%%cd*}
            \\${v#*\a\b},${v##*\ab},${v%c\d*},${v%%\c\d*}
            \\${v#*"ab"},${v##*"a"b},${v%c"d"*},${v%%"cd"*}
            \\${v#*'ab'},${v##*'a'b},${v%c'd'*},${v%%'cd'*}
            \\EOF
            ,
            .stdout =
            \\abcdcd,cdcd,ababcd,abab
            \\abcdcd,cdcd,ababcd,abab
            \\abcdcd,cdcd,ababcd,abab
            \\abcdcd,cdcd,ababcd,abab
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document expansion stderr sees earlier redirections",
            .script =
            \\cat 2>err <<EOF
            \\$(printf hi; printf err >&2)
            \\EOF
            \\printf '\nERR:'
            \\cat err
            ,
            .stdout =
            \\hi
            \\
            \\ERR:err
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document expansion stderr precedes later redirections",
            .script =
            \\exec 2>&1
            \\cat <<EOF 2>err
            \\$(printf hi; printf err >&2)
            \\EOF
            \\printf '\nERR:'
            \\cat err
            ,
            .stdout =
            \\errhi
            \\
            \\ERR:
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "multiple here documents are supplied in redirection order",
            .script =
            \\cat <<A <<B
            \\one
            \\A
            \\two
            \\B
            ,
            .stdout =
            \\two
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document backslash quotes dollar backquote and backslash",
            .script = "cat <<EOF\n\\$HOME\n\\`echo bad\\`\n\\\\slash\nEOF\n",
            .stdout =
            \\$HOME
            \\`echo bad`
            \\\slash
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document dash strips leading tabs",
            .script = "cat <<-EOF\n\tone\n\t\ttwo\nEOF\n",
            .stdout =
            \\one
            \\two
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document removes backslash newline after operator",
            .script = "cat <<\\\nEOF\nhello\nEOF\n",
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document removes backslash newline in delimiter word",
            .script = "cat <<EO\\\nF\nhello\nEOF\n",
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "quoted here document delimiter removes backslash newline",
            .script = "cat <<\"EO\\\nF\"\n$HOME\nEOF\n",
            .stdout =
            \\$HOME
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document dash removes backslash newline after operator",
            .script = "cat <<-\\\nEOF\n\thello\nEOF\n",
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document body does not expand when delimiter is quoted",
            .script =
            \\x=value
            \\cat <<'EOF'
            \\<$x>
            \\EOF
            ,
            .stdout =
            \\<$x>
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "quoted here document in command substitution preserves backslash newline",
            .script =
            \\v=$(cat <<'EOF'
            \\def \
            \\ghi
            \\EOF
            \\)
            \\printf '%s\n' "$v"
            ,
            .stdout =
            \\def \
            \\ghi
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document dash line continuation preserves continued tabs",
            .script = "v=$(cat <<-END\n\tabc\n\tdef \x5c\n\tghi\n\tjkl\x5c\n\tEND\n\tEND\n)\nprintf '%s\\n' \"$v\"\n",
            .stdout = "abc\ndef \tghi\njkl\tEND\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document dash strips tabs after an even backslash run",
            .script = "cat <<-EOF\n\ta\\\\\n\tSHORTLOG\n\tEOF\n",
            .stdout = "a\\\nSHORTLOG\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a simple pipeline stage",
            .script =
            \\cat <<EOF | cat
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds an and-or list command",
            .script =
            \\cat <<EOF && echo yes
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\yes
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "multiple here documents feed separate and-or list commands",
            .script =
            \\cat <<A && cat <<B
            \\one
            \\A
            \\two
            \\B
            ,
            .stdout =
            \\one
            \\two
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a case arm command",
            .script =
            \\case x in x) cat <<EOF ;; esac
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a subshell pipeline stage",
            .script =
            \\( cat <<EOF ) | cat
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "compound pipeline stages keep separate here documents",
            .script =
            \\( cat <<A ) | { read x; cat <<B; printf '%s\n' "$x"; }
            \\left
            \\A
            \\right
            \\B
            ,
            .stdout =
            \\right
            \\left
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a function body command before same-line invocation",
            .script =
            \\f() { cat <<EOF; }; f
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a loop body command",
            .script =
            \\for i in 1; do cat <<EOF; done
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a loop condition command",
            .script =
            \\while read value; do printf 'in=%s\n' "$value"; done <<EOF
            \\new
            \\EOF
            \\printf 'out=%s\n' "$value"
            ,
            .stdout =
            \\in=new
            \\out=
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document inside loop body is not executed as source",
            .script =
            \\i=0
            \\while [ "$i" -lt 2 ]; do
            \\  cat <<EOF
            \\body-$i
            \\EOF
            \\  i=$((i+1))
            \\done
            ,
            .stdout =
            \\body-0
            \\body-1
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here document feeds a brace group body command",
            .script =
            \\{ cat <<EOF; }
            \\hello
            \\EOF
            ,
            .stdout =
            \\hello
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here-document body follows the newline that continues a pipeline",
            .script =
            \\cat <<EOF |
            \\body
            \\EOF
            \\wc -c
            ,
            .stdout =
            \\5
            \\
            ,
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "here-document body follows the newline that continues an AND list",
            .script =
            \\cat <<EOF &&
            \\body
            \\EOF
            \\printf 'ok\n'
            ,
            .stdout =
            \\body
            \\ok
            \\
            ,
            .stderr = "",
            .status = 0,
        },
    },
}
