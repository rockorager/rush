.{
    .name = "System shell workload regressions",
    .mode = .posix,
    .cases = .{
        .{
            .name = "plus i invocation accepts all input forms and cancels earlier minus i",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\printf '%s\n' 'case $- in *i*) echo interactive;; *) echo noninteractive;; esac' >input
            \\./sh +i -c "$(cat input)"
            \\./sh -i +i input
            \\./sh +i <input
            \\./sh +i -i -c "$(cat input)" 2>/dev/null
            ,
            .stdout = "noninteractive\nnoninteractive\nnoninteractive\ninteractive\n",
            .stderr = "",
            .status = 0,
        },
        .{
            .name = "system shell external prefix assignments expand exactly once",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\x=foo
            \\x=$x.bar printenv x
            \\x=$x.bar command printenv x
            \\(x=$x.bar exec printenv x)
            \\x=$x.bar printenv x | cat
            \\x=$(printf tick >>marker; printf value) printenv x
            \\cat marker; echo
            \\printf '%s\n' "$x"
            \\x=first x=$x.second ./sh -c 'echo "$x"'
            ,
            .stdout = "foo.bar\nfoo.bar\nfoo.bar\nfoo.bar\nvalue\ntick\nfoo\nfirst.second\n",
        },
        .{
            .name = "inherited exports survive read arithmetic and readonly assignments",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\PROBE=1 ./sh -c ': "$((PROBE=2))"; printenv PROBE'
            \\PROBE=1 ./sh -c 'read PROBE; printenv PROBE' <<EOF
            \\2
            \\EOF
            \\PROBE=1 ./sh -c 'readonly PROBE=2; printenv PROBE'
            \\PROBE=1 ./sh -c 'readonly PROBE; printenv PROBE'
            \\./sh -c 'export PROBE=1; : "$((PROBE=2))"; printenv PROBE'
            \\PROBE= ./sh -c ': "${PROBE:=2}"; printenv PROBE'
            ,
            .stdout = "2\n2\n2\n1\n2\n2\n",
        },
        .{
            .name = "unset masks inherited values and removes their export attribute",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\PROBE=1 ./sh <<'EOF'
            \\unset PROBE
            \\printf 'value:%s\n' "${PROBE-unset}"
            \\printenv PROBE; printf 'status:%s\n' "$?"
            \\PROBE=2
            \\printf 'value:%s\n' "$PROBE"
            \\printenv PROBE; printf 'status:%s\n' "$?"
            \\export PROBE
            \\printenv PROBE
            \\unset PROBE
            \\PROBE=temp printenv PROBE
            \\PROBE=temp true
            \\printf 'value:%s\n' "${PROBE-unset}"
            \\printenv PROBE; printf 'status:%s\n' "$?"
            \\EOF
            ,
            .stdout = "value:unset\nstatus:1\nvalue:2\nstatus:1\n2\ntemp\nvalue:unset\nstatus:1\n",
        },
        .{
            .name = "unset inherited values remain scoped to subshells and local variables",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\PROBE=1 ./sh <<'EOF'
            \\(unset PROBE; printf 'subshell:%s\n' "${PROBE-unset}")
            \\printenv PROBE
            \\f() { local PROBE=local; unset PROBE; printf 'local:%s\n' "${PROBE-unset}"; }
            \\f
            \\printenv PROBE
            \\unset PROBE
            \\f
            \\printf 'outer:%s\n' "${PROBE-unset}"
            \\EOF
            ,
            .stdout = "subshell:unset\n1\nlocal:unset\n1\nlocal:unset\nouter:unset\n",
        },
        .{
            .name = "unset inherited HOME and PATH cannot fall back to startup values",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\mkdir bin
            \\printf '%s\n' '#!/bin/sh' 'echo BAD' >bin/probe-inherited-path
            \\chmod +x bin/probe-inherited-path
            \\PATH="$PWD/bin:$PATH" HOME=/inherited ./sh <<'EOF'
            \\unset PATH HOME
            \\if command -v probe-inherited-path >/dev/null; then echo BAD; else echo absent; fi
            \\printf '%s:%s\n' "${HOME-unset}" "${PATH-unset}"
            \\EOF
            ,
            .stdout = "absent\nunset:unset\n",
        },
        .{
            // Coreutils and findutils prepend build helpers to inherited PATH.
            .name = "assignments preserve inherited export attributes",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\PROBE=before ./sh -c 'PROBE=after; printenv PROBE'
            \\./sh -c 'PATH=/probe; /usr/bin/printenv PATH'
            \\PROBE=before ./sh -c 'PROBE=one; PROBE=two; printenv PROBE'
            ,
            .stdout = "after\n/probe\ntwo\n",
        },
        .{
            .name = "child shell preserves an inherited logical PWD",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\mkdir -p real
            \\ln -s real logical
            \\cd logical
            \\./../sh -c 'case $PWD in */logical) echo logical;; *) echo physical;; esac'
            ,
            .stdout = "logical\n",
        },
        .{
            .name = "child shell replaces invalid inherited PWD values",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\mkdir actual stale
            \\cd actual
            \\actual=$PWD
            \\PWD=relative ./../sh -c '[ "$PWD" = "$1" ] && echo physical' sh "$actual"
            \\PWD="$TMPDIR/stale" ./../sh -c '[ "$PWD" = "$1" ] && echo physical' sh "$actual"
            ,
            .stdout = "physical\nphysical\n",
        },
        .{
            .name = "child shell starts after its working directory is deleted",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\child=$PWD/sh
            \\parent=$PWD
            \\mkdir deleted
            \\cd deleted
            \\rmdir "$parent/deleted"
            \\"$child" -c 'printf "child-started\n"'
            ,
            .stdout = "child-started\n",
            // Reference shells may warn when getcwd(2) fails.
            .stderr_match = .any,
        },
        .{
            // Reduced from Git 2.39.5's check-chainlint Make recipe.
            .name = "brace groups accept a final unseparated compound command",
            .script =
            \\{ for value in x; do printf '%s\n' "$value"; done }
            \\{ if true; then printf 'if\n'; fi }
            \\{ (printf 'subshell\n') }
            \\{ f() { printf 'function\n'; } }
            \\f
            ,
            .stdout = "x\nif\nsubshell\nfunction\n",
        },
        .{
            // Debian Policy 10.4 requires local in /bin/sh; this is a
            // deliberate compatibility requirement beyond POSIX Issue 8.
            .name = "Debian maintainer scripts can localize assigned variables",
            .script =
            \\set -e
            \\value=outer
            \\f() {
            \\    local a b value=inner
            \\    printf '%s\n' "$value"
            \\}
            \\f
            \\printf '%s\n' "$value"
            ,
            .stdout = "inner\nouter\n",
        },
        .{
            // Reduced from gzip 1.12's zdiff, reached by make check-local.
            .name = "gzip zdiff nests pipeline subshells inside command substitution",
            .script =
            \\value=$(
            \\    : | ((printf x
            \\          printf y) | cat)
            \\)
            \\printf '<%s>\n' "$value"
            ,
            .stdout = "<xy>\n",
        },
        .{
            // Reduced from gzip 1.12's zgrep --label argument quoting.
            .name = "gzip zgrep preserves escaped double quotes inside command substitution",
            .script =
            \\value=$(printf '%s\n' "\"x\"")
            \\printf '<%s>\n' "$value"
            ,
            .stdout = "<\"x\">\n",
        },
        .{
            // Reduced from Automake's mdate-sh, used by gzip's doc build.
            .name = "Automake backquote eval preserves an escaped variable reference",
            .script =
            \\save_arg1=target
            \\ls_command=show
            \\show() { printf '<%s>\n' "$1"; }
            \\result=`eval "$ls_command \"\\\$save_arg1\""`
            \\printf '%s\n' "$result"
            ,
            .stdout = "<target>\n",
        },
        .{
            .name = "interactive command string sources ENV before its body",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\printf '%s\n' 'printf "ENV\n"' >startup
            \\ENV="$PWD/startup" ./sh -ic 'printf "BODY\n"' 2>diagnostics
            ,
            .stdout = "ENV\nBODY\n",
        },
        .{
            .name = "local assignments preserve spaces and restore the caller variable",
            .script =
            \\value=outer
            \\f() { local value=$1; printf '<%s>\n' "$value"; }
            \\f 'two words'
            \\printf '%s\n' "$value"
            ,
            .stdout = "<two words>\nouter\n",
        },
        .{
            .name = "interactive script sources ENV but noninteractive command does not",
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\printf '%s\n' 'printf "ENV\n"' >startup
            \\printf '%s\n' 'printf "SCRIPT\n"' >body
            \\ENV="$PWD/startup" ./sh -i body 2>diagnostics
            \\ENV="$PWD/startup" ./sh -c 'printf "COMMAND\n"'
            ,
            .stdout = "ENV\nSCRIPT\nCOMMAND\n",
        },
        .{
            .name = "exit in interactive ENV prevents command execution and runs EXIT trap",
            .script =
            \\ln -s "$(command -v "$0")" sh
            \\printf '%s\n' "trap 'printf EXIT' 0" 'exit 7' >startup
            \\ENV="$PWD/startup" ./sh -ic 'printf BAD' 2>diagnostics
            ,
            .stdout = "EXIT",
            .status = 7,
        },
        .{
            // POSIX sh must ignore ENV while IDs differ. Dropping privilege
            // first is also safe, so only execution with unequal IDs fails.
            .name = "interactive ENV cannot execute with mismatched real and effective UID",
            .requires_root = true,
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\cat >startup <<'EOF'
            \\if [ "$(id -ru)" != "$(id -u)" ]; then printf 'UNSAFE-ENV\n'; fi
            \\EOF
            \\mkdir -p config/rush
            \\cp startup config/rush/config.rush
            \\export XDG_CONFIG_HOME="$PWD/config"
            \\ENV="$PWD/startup" "$RUSH_CONFORMANCE_HARNESS" --mismatched-ids uid ./sh -i 2>diagnostics <<'EOF'
            \\printf 'BODY\n'
            \\exit
            \\EOF
            \\ENV="$PWD/startup" "$RUSH_CONFORMANCE_HARNESS" --mismatched-ids uid ./sh -ic 'printf "BODY\n"' 2>diagnostics
            ,
            .stdout = "BODY\nBODY\n",
        },
        .{
            .name = "interactive ENV cannot execute with mismatched real and effective GID",
            .requires_root = true,
            .script =
            \\set -e
            \\ln -s "$(command -v "$0")" sh
            \\cat >startup <<'EOF'
            \\if [ "$(id -rg)" != "$(id -g)" ]; then printf 'UNSAFE-ENV\n'; fi
            \\EOF
            \\mkdir -p config/rush
            \\cp startup config/rush/config.rush
            \\export XDG_CONFIG_HOME="$PWD/config"
            \\ENV="$PWD/startup" "$RUSH_CONFORMANCE_HARNESS" --mismatched-ids gid ./sh -i 2>diagnostics <<'EOF'
            \\printf 'BODY\n'
            \\exit
            \\EOF
            \\ENV="$PWD/startup" "$RUSH_CONFORMANCE_HARNESS" --mismatched-ids gid ./sh -ic 'printf "BODY\n"' 2>diagnostics
            ,
            .stdout = "BODY\nBODY\n",
        },
    },
}
